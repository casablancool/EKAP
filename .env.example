# Anthropic API anahtarı (SDK kendisi okur; asla commit etmeyin)
ANTHROPIC_API_KEY=

# Modeller (yalnızca ayarlar.py fiyat tablosundakiler)
EKAP_MODEL_ANALIZ=claude-sonnet-5-5
EKAP_MODEL_ESLESTIRME=claude-opus-5-5
EKAP_EFOR_ANALIZ=low
EKAP_EFOR_ESLESTIRME=medium
EKAP_MAX_TOKENS=16000

# Maliyet ve filtre
EKAP_GUNLUK_LIMIT_USD=5.0
EKAP_MIN_GUN_KALAN=3
EKAP_MALIYET_TOLERANS=0.2
EKAP_KESIN_RED_ESIGI=0.25
EKAP_GERI_BAKIS_GUN=3
EKAP_ISTEK_ARALIGI_SN=2.5

# Dizinler
EKAP_VERI_DIZINI=veri
EKAP_CIKTI_DIZINI=cikti

# Kaynak: dosya (ilanlar/) veya ekap (Plan 3)
EKAP_KAYNAK=dosya

# E-posta (Gmail: uygulama şifresi)
SMTP_SUNUCU=smtp.gmail.com
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
EKAP_GONDEREN=
EKAP_YONETICI_EPOSTA=
EKAP_HAFTALIK_BOS_NOT=false
